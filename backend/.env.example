# Environment Configuration for RETRACE Backend
ENVIRONMENT=development

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Storage (Bucket name for immutable raw industrial evidence files)
# When unset or empty, backend safely uses local development directory storage
GCS_BUCKET_NAME=

# PostgreSQL Database (Connection URL for durable uploaded evidence metadata)
# e.g., postgresql+psycopg://user:password@hostname:5432/retrace
DATABASE_URL=

# Neo4j Graph Database (Incident Context Graph & Asset Topology)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Qdrant Semantic Vector Retrieval Layer (Server-side only, Cloud Run Secrets)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=retrace_evidence_v1
QDRANT_VECTOR_SIZE=768

# Vertex AI Multimodal Embedding Settings (Service Account / ADC on Cloud Run)
GOOGLE_CLOUD_PROJECT=retrace-abb-2026
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
